#!/bin/sh
set -eu
# Runs inside the live image during build.
mkdir -p /etc/skel/Desktop /usr/share/backgrounds/noeyeos
cat > /etc/skel/Desktop/Install-NoEyeOS.desktop <<'EOF'
[Desktop Entry]
Type=Application
Name=Install NoEyeOS permanently
Comment=Install NoEyeOS to your computer's drive
Exec=pkexec calamares
Icon=system-software-install
Terminal=false
Categories=System;
EOF
chmod 0755 /etc/skel/Desktop/Install-NoEyeOS.desktop
# Also expose installer in the applications menu.
mkdir -p /usr/share/applications
cp /etc/skel/Desktop/Install-NoEyeOS.desktop /usr/share/applications/noeyeos-installer.desktop
# Dark monochrome XFCE defaults inspired by the supplied reference.
mkdir -p /etc/skel/.config/xfce4/xfconf/xfce-perchannel-xml
cat > /etc/skel/.config/xfce4/xfconf/xfce-perchannel-xml/xsettings.xml <<'EOF'
<?xml version="1.0" encoding="UTF-8"?>
<channel name="xsettings" version="1.0">
  <property name="Net" type="empty">
    <property name="ThemeName" type="string" value="Adwaita-dark"/>
    <property name="IconThemeName" type="string" value="Adwaita"/>
  </property>
</channel>
EOF
